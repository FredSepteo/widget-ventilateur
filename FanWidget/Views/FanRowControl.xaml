<UserControl x:Class="FanWidget.Views.FanRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Margin="0,0,0,10">
    <Border x:Name="PanelBorder" Background="#121A22" CornerRadius="14" Padding="14"
            BorderBrush="#1E2A36" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserLabel}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0F4F8" VerticalAlignment="Center"/>
                    <Button x:Name="RenameButton" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Width="26" Height="26" Margin="4,0,0,0" Cursor="Hand"
                            ToolTip="Renommer" Click="Rename_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="#7B8C9C"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1C2834"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border x:Name="ModeBadge" Background="#2A3A48" CornerRadius="6"
                            Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeText" Text="{Binding ModeLabel}" FontSize="10"
                                   FontWeight="Bold" Foreground="#7B8C9C"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RpmText}" FontSize="11" Foreground="#7B8C9C" Margin="0,0,10,0"/>
                    <TextBlock x:Name="PercentText" FontSize="12" FontWeight="SemiBold" Foreground="#2EE6A8"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="FanSlider" Style="{StaticResource FanSlider}"
                        Minimum="0" Maximum="100"
                        Value="{Binding SliderValue, Mode=TwoWay}" Margin="0,0,10,0"
                        ValueChanged="FanSlider_ValueChanged"/>
                <Button x:Name="AutoButton" Grid.Column="1" Content="Auto" Style="{StaticResource AutoButton}"
                        Click="Auto_Click"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HardwareName}" FontSize="11"
                           Foreground="#7B8C9C" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <Border x:Name="P100FloorBadge" Grid.Column="1" Background="#1A2834" CornerRadius="6"
                        Padding="7,2" VerticalAlignment="Center" HorizontalAlignment="Right"
                        BorderBrush="#2EE6A8" BorderThickness="1" Visibility="Collapsed"
                        ToolTip="Plancher permanent — refroidissement GPU P100">
                    <TextBlock x:Name="P100FloorText" Text="P100 ≥30 %" FontSize="10"
                               FontWeight="Bold" Foreground="#2EE6A8"/>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
