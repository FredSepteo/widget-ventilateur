<Window x:Class="FanWidget.Views.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profils utilisateur"
        Width="420"
        Height="460"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0F1419"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profils" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                   Text="Enregistrez les réglages de puissance des ventilateurs et l'état du GPU P100. L'affichage des ventilateurs se règle dans Options."/>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <ListBox x:Name="ProfileList" Style="{StaticResource AirflowListBox}"
                     SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,12">
            <Button Content="Nouveau" Style="{StaticResource AirflowButton}" Margin="0,0,8,0" Click="New_Click"/>
            <Button Content="Enregistrer l'état actuel" Style="{StaticResource AirflowButton}" Margin="0,0,8,0" Click="SaveCurrent_Click"/>
            <Button x:Name="EditButton" Content="Modifier" Style="{StaticResource AirflowButton}" IsEnabled="False" Click="Edit_Click"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton" Content="Appliquer" Style="{StaticResource AirflowPrimaryButton}"
                        Margin="0,0,8,0" IsEnabled="False" Click="Apply_Click"/>
                <Button x:Name="StartupButton" Content="Profil de démarrage" Style="{StaticResource AirflowButton}"
                        Margin="0,0,8,0" IsEnabled="False" Click="Startup_Click"/>
                <Button x:Name="DeleteButton" Content="Supprimer" Style="{StaticResource AirflowDangerButton}"
                        IsEnabled="False" Click="Delete_Click"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Fermer" Style="{StaticResource AirflowButton}"
                    Margin="12,0,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
