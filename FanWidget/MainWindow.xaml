<Window x:Class="FanWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ventilateurs PC"
        Width="360"
        SizeToContent="Height"
        MinWidth="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border CornerRadius="16" BorderBrush="#2A3A48" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C1218" Offset="0"/>
                <GradientStop Color="#101820" Offset="0.55"/>
                <GradientStop Color="#0B1614" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="RootGrid" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0"
                            Background="#14352C" BorderBrush="#2A5A48" BorderThickness="1">
                        <TextBlock Text="&#xE826;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource AccentBrush}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Airflow" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Initialisation..." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#xE81C;" Style="{StaticResource IconButton}" Click="Profiles_Click" ToolTip="Profils utilisateur"/>
                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="Options_Click" ToolTip="Options"/>
                    <Button Content="&#xE921;" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Réduire dans la barre"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Réduire (Quitter via icône)"/>
                </StackPanel>
            </Grid>

            <!-- Tuile profils -->
            <Border Grid.Row="1" Background="{StaticResource ChipBrush}" CornerRadius="10"
                    Padding="12,10" Margin="0,0,0,10" BorderBrush="#1E2A36" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Profil" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ProfileBadgesPanel"/>
                    <TextBlock x:Name="ProfileEmptyHint" Text="Aucun profil — gérez-les via l'icône liste"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Tuiles P100 + ventilateurs (1 ou 2 colonnes selon le nombre visible) -->
            <Grid x:Name="TilesPanel" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TilesLeftColumnDef" Width="*"/>
                    <ColumnDefinition x:Name="TilesGapColumnDef" Width="0"/>
                    <ColumnDefinition x:Name="TilesRightColumnDef" Width="0"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TilesLeftColumn" Grid.Column="0">
                    <Border x:Name="P100Tile" Background="{StaticResource PanelBrush}" CornerRadius="14"
                            Padding="14" Margin="0,0,0,10" BorderBrush="#1E2A36" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0"
                                        Background="#1A1E28" BorderBrush="#3A3050" BorderThickness="1">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#9B8AC2" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GPU P100" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border x:Name="P100StatusBadge" Background="#2A3A48" CornerRadius="6"
                                                Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="P100StatusText" Text="…" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="P100ToggleButton" Content="P100 OFF"
                                    Style="{StaticResource AirflowDangerButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="P100Toggle_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="TilesRightColumn" Grid.Column="2"/>
            </Grid>

            <TextBlock Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Réduire → icône près de l'horloge · Quitter via menu"/>
        </Grid>
    </Border>
</Window>
